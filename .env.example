# MONEY COMMAND | ENVIRONMENT CONFIGURATION (.env.example)
# Do not store production secrets in code.

# Supabase PostgreSQL Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Meta WhatsApp Cloud API (Sandbox)
META_WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
META_WHATSAPP_ACCESS_TOKEN=your-meta-system-user-token
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token
META_APP_SECRET=your-meta-app-secret-for-hmac-sha256

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

